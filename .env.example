# Required for real AI output (extraction, ICP drafting, interview, scoring).
# Without it the app runs in a clearly-labelled offline mock mode.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required only for Search Execution (page 10 — submits a Sales Navigator URL to Vayne).
VAYNE_API_TOKEN=your_vayne_api_token_here

# Optional: webhook URL — Vayne will POST the completed CSV download URL here
# when each scraping order finishes. Useful for n8n / make.com integrations.
# Can also be passed per-run with --webhook URL on the scrape command.
# VAYNE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/vayne

# Optional: Google Sheets publishing (Sprint 14). Provide EITHER a path to a service-account
# JSON key file, OR the service-account JSON inline (e.g. injected from Streamlit secrets).
# Never commit real credentials.
# GOOGLE_SHEETS_CREDENTIALS_FILE=/absolute/path/to/service-account.json
# GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account", ...}
