# ── Secrets ──────────────────────────────────────────────────────────────────
# Leave blank to run the offline mocks (clearly labelled in the UI).
ANTHROPIC_API_KEY=
VAYNE_API_TOKEN=

# Default qualifying score threshold (0-100); also adjustable in the UI.
SCORE_THRESHOLD=60

# Optional: Vayne POSTs the completed CSV download URL to this webhook when an order finishes.
# VAYNE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/vayne

# ── Persistence ──────────────────────────────────────────────────────────────
# local = filesystem under STORAGE_LOCAL_ROOT (dev). oci = Oracle Object Storage (deployment).
STORAGE_BACKEND=local
# STORAGE_LOCAL_ROOT=./data

# Oracle Cloud Object Storage (used only when STORAGE_BACKEND=oci)
# OCI_BUCKET=gtm-intelligence
# OCI_NAMESPACE=                         # blank -> auto-detected from the tenancy
# OCI_REGION=eu-frankfurt-1
# OCI_AUTH=instance_principal            # instance_principal (VM + dynamic group) | config_file
# OCI_CONFIG_FILE=/home/appuser/.oci/config   # only when OCI_AUTH=config_file
# OCI_CONFIG_PROFILE=DEFAULT

# ── Deployment: Caddy reverse proxy (docker-compose) ─────────────────────────
# APP_DOMAIN=leads.example.com   # real domain -> automatic Let's Encrypt TLS (recommended)
# APP_USER=admin
# Password hash — IMPORTANT: escape every '$' as '$$' (docker-compose eats single '$'):
#   docker run --rm --entrypoint caddy caddy:2.8 hash-password --plaintext 'your-password' | sed 's/\$/$$/g'
# APP_PASSWORD_HASH=
# CADDY_TLS=tls internal         # only for self-signed local/IP testing (browser warns); omit for a domain
