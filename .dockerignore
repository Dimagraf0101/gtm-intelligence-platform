# Keep the build context small and secrets out of the image.
.git
.gitignore
.venv
**/__pycache__
**/*.pyc
.env
.env.*
!.env.example

# Local data / outputs / dev-only material (persistence is external in prod).
data
outputs
pilot_results
archive
tests
scripts
docs
icp
.claude
*.md
!prompts/*.md

# OS / editor noise
.DS_Store
